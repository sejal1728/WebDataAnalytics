# Implement Spam Classifier.  

  

from sklearn.feature_extraction.text import CountVectorizer  

from sklearn.naive_bayes import MultinomialNB  

from sklearn.pipeline import make_pipeline  

  

# Sample dataset (spam vs ham messages)  

data = [  

    ("Win a free iPhone now!!!", "spam"),  

    ("Congratulations, you won a lottery!", "spam"),  

    ("Click here to claim your prize", "spam"),  

    ("Meeting at 5 pm today", "ham"),  

    ("Can we reschedule the call?", "ham"),  

    ("Don’t forget to bring the documents", "ham")  

]  

  

# Separate text and labels  

texts, labels = zip(*data)  

  

# Build a pipeline: Vectorizer + Naive Bayes Classifier  

model = make_pipeline(CountVectorizer(), MultinomialNB())  

  

# Train the classifier  

model.fit(texts, labels)  

  

# Test on new messages  

test_messages = [  

    "Win cash prize now!",  

    "Let’s have lunch tomorrow",  

    "Claim your free voucher",  

    "Can you send me the report?"  

]  

  

predictions = model.predict(test_messages)  

  

# Show results  

for msg, label in zip(test_messages, predictions):  

    print(f"Message: '{msg}' --> Predicted: {label}")
